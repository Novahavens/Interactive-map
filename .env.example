# --- Browser (public) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID is required for Advanced Markers. Create one in Google Cloud Console → Maps → Map Management.
# DEMO_MAP_ID works for testing only.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# --- Server only (never shipped to the browser) ---
SUPABASE_URL=https://nmandvqfuwvqxeabptjd.supabase.co
# Publishable key is sufficient: the four RPCs are SECURITY DEFINER and granted to anon; the table itself is RLS-locked.
SUPABASE_KEY=
MONDAY_API_TOKEN=
# Set to 1 for local runs: Add to claim logs the payload instead of writing to Monday. Never set in production.
MONDAY_DRY_RUN=1

# Board wiring (defaults match PRD v4 §8.3; override only if boards change)
MONDAY_PROPERTY_BOARD_ID=18415735059
MONDAY_CLAIM_BOARD_ID=9030696652
MONDAY_CLAIM_SUBITEM_BOARD_ID=9205253360

# Active Claims drawer: claim-board groups that mean "waiting on housing options" (default: New Housing Request, New Option Needed)
# MONDAY_ACTIVE_CLAIM_GROUPS=topics,group_mkvngrgz
# MONDAY_TEST_CLAIM_GROUP=group_mm1jnpwf

# Report a problem (help button): posts to Slack with a bot token. Without these, local and preview
# runs log the report to the server console instead; production returns "not connected".
# Scopes: chat:write, files:write. Invite the bot to the channel; use the channel ID (C…), not its name.
SLACK_BOT_TOKEN=
SLACK_SUPPORT_CHANNEL_ID=
