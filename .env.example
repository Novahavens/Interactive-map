# --- Browser (public) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID is required for Advanced Markers. Create one in Google Cloud Console → Maps → Map Management.
# DEMO_MAP_ID works for testing only.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# --- Server only (never shipped to the browser) ---
SUPABASE_URL=https://nmandvqfuwvqxeabptjd.supabase.co
# Publishable key is sufficient: the four RPCs are SECURITY DEFINER and granted to anon; the table itself is RLS-locked.
SUPABASE_KEY=
MONDAY_API_TOKEN=
# Set to 1 for local runs: Add to claim logs the payload instead of writing to Monday. Never set in production.
MONDAY_DRY_RUN=1

# Board wiring (defaults match PRD v4 §8.3; override only if boards change)
MONDAY_PROPERTY_BOARD_ID=18415735059
MONDAY_CLAIM_BOARD_ID=9030696652
MONDAY_CLAIM_SUBITEM_BOARD_ID=9205253360

# Active Claims drawer: claim-board groups that mean "waiting on housing options" (default: New Housing Request, New Option Needed)
# MONDAY_ACTIVE_CLAIM_GROUPS=topics,group_mkvngrgz
# MONDAY_TEST_CLAIM_GROUP=group_mm1jnpwf

# Quo (Settings -> API). Optional: without it the owner card shows no contact history.
# QUO_API_KEY=

# --- Housing agent on the map (every feature is OFF unless named here) ---
# Comma list of: outside, bestMatch, chat, addOutside, submit, mine, nearsite, findPhone, templates (or "all").
# Everything except "mine" also needs MAP_EDIT_SECRET (the same server secret as listing edits) and the
# 20261126_map_agent.sql migration applied. GET /api/health reports what is really on.
# MAP_FEATURES=
# MAP_EDIT_SECRET=
# chat + addOutside: the Search Chat webhook address and its panel key. Server only; never NEXT_PUBLIC_.
# MAP_CHAT_URL=
# MAP_CHAT_TOKEN=
# Optional: who the map is to the Search Chat workflow (default "map"). Must be on its pilot list if one is set.
# MAP_CHAT_USER_ID=
# findPhone: the owner-phone lookup webhook. Gets { propertyId, address, city, state, zip }, answers { phone, source?, confidence? }.
# MAP_PHONE_URL=
# Optional shared secret sent to the lookup webhook in the x-map-secret header.
# MAP_PHONE_TOKEN=
